{
  "info": {
    "name": "HR Management - Staff Attendance & Leaves",
    "description": "مجموعة مسارات API الخاصة بنظام حضور وإجازات الموظفين جاهزة للاختبار.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/admin",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_bearer_token_here",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Staff Attendances (الحضور والغياب)",
      "item": [
        {
          "name": "Create Attendance Record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staff_id\": 1,\n  \"attendance_date\": \"2026-08-10\",\n  \"status\": \"partial_absence\",\n  \"absence_type\": \"excused\",\n  \"missing_periods\": [1, 3]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/staff-attendances",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "staff-attendances"
              ]
            }
          }
        },
        {
          "name": "Get Attendance Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/staff-attendances/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "staff-attendances",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Update Attendance (Wipe & Replace)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"absent\",\n  \"absence_type\": \"unexcused\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/staff-attendances/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "staff-attendances",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Attendance Record",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/staff-attendances/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "staff-attendances",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
